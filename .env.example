# Poolside Pulse Version X only. Never copy values from another Serenity Shores project.
POOL_SIDE_PIN=
POOL_SIDE_SESSION_SECRET=
# Give every isolated Preview deployment its own durable namespace so it cannot
# read or mutate the current Version X Receiver, schedule, or command state.
POOL_SIDE_X_NAMESPACE=

# Durable shared receiver, schedule, and command state (required in production).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional natural announcement voice.
OPENAI_API_KEY=

# Apple Music / MusicKit. Create a dedicated Media ID and Media Services key
# for Poolside Pulse Version X. APPLE_MUSIC_PRIVATE_KEY must contain the PEM
# text from the .p8 file; configure it only as a protected server secret.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_MEDIA_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_ALLOWED_ORIGINS=https://poolside-pulse-x.vercel.app,https://poolside-pulse-x-receiver.vercel.app

# Automatic Receiver wake transport. The API key is a protected server secret
# and needs Resend Full access so future scheduled wake emails can be cancelled
# or renewed safely.
# With Resend's test sender, RECEIVER_WAKE_EMAIL_X must be the email address on
# the Resend account. A verified custom domain may use another sender/recipient.
RESEND_API_KEY_X=
RECEIVER_WAKE_EMAIL_X=
RECEIVER_WAKE_FROM_X=Poolside Pulse X <onboarding@resend.dev>
RECEIVER_WAKE_SUBJECT_X=Poolside Pulse X Wake

# Permanent public origin used by the signed iPhone Receiver Shortcut. Keep this
# on the dedicated Receiver alias, not on a branch-specific deployment URL.
PUSHCUT_PUBLIC_BASE_URL_X=https://poolside-pulse-x-receiver.vercel.app

# Optional commercial weather provider supplement.
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

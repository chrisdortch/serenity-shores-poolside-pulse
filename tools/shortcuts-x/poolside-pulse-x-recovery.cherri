/*
Poolside Pulse X Recovery

Handles both immediate manager volume changes and signed recovery requests.
Music resumes only when the Version X payload explicitly requests it.
*/

#include 'actions/device'
#include 'actions/music'
#include 'actions/web'

#define name Poolside Pulse X Recovery
#define color orange
#define mac false

action 'getvalueforkey' getFloatValue(
    dictionary dictionary: 'WFInput',
    text key: 'WFDictionaryKey'
): float {
    "WFGetDictionaryValueType": "Value"
}

@recoveryDictionary = getDictionary(ShortcutInput)
const recoveryUrl = getValue(@recoveryDictionary, "recoveryUrl")

if recoveryUrl {
    const recoveryResponse = downloadURL("{recoveryUrl}")
    @recoveryDictionary = getDictionary(recoveryResponse)
    const shouldRecover = getValue(@recoveryDictionary, "shouldRecover")
    if shouldRecover.text != "1" {
        stop()
    }
}

const musicLevel = getFloatValue(@recoveryDictionary, "musicLevel")
setVolume(musicLevel)

const resumeMusic = getValue(@recoveryDictionary, "resumeMusic")
if resumeMusic.text == "1" {
    play()
}
